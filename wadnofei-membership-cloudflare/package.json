{
  "name": "wadnofei-membership-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute DB --local --file=./schema.sql",
    "db:backup": "wrangler d1 export DB --remote --output=./membership-backup.sql",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "build": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "wrangler": "^4.34.0",
    "miniflare": "^4.0.0"
  }
}
