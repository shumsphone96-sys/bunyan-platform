{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wadnofei-membership",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "members.shamsphone.net",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_NAME": "نادي ود نفيع الرياضي الثقافي الاجتماعي",
    "APP_ORIGIN": "https://members.shamsphone.net",
    "WHATSAPP_PHONE_NUMBER_ID": "1320804307779976",
    "WHATSAPP_BUSINESS_ACCOUNT_ID": "488322071036886",
    "WHATSAPP_TEST_RECIPIENT": "249912930540",
    "WHATSAPP_MODE": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wadnofei-membership-db",
      "database_id": "39725aeb-ec00-4ae2-b7ef-1c68cce00f1d"
    }
  ]
}
